# ─────────────────────────────────────────────────────────────
# manno & momo — environment
# copy this file to .env.local and fill it in. see SETUP.md.
# for Vercel: paste these into Project → Environment Variables.
# full deploy guide: DEPLOY.md
# ─────────────────────────────────────────────────────────────

# ── the two of you ───────────────────────────────────────────
# a password each — not a shared one. the site needs to know
# which of you wrote which version.
#
# don't set these by hand. run:  npm run set-password
# it hashes the password and writes the *_HASH lines below,
# so the plaintext is never stored anywhere.
MANNO_PASSWORD_HASH=
MOMO_PASSWORD_HASH=

# fallback: plaintext, used only if the matching *_HASH is empty.
# fine for localhost, but prefer the hashes when you deploy.
MANNO_PASSWORD=
MOMO_PASSWORD=

# labels only — auth never touches these
MANNO_EMAIL=
MOMO_EMAIL=

# ── sessions ─────────────────────────────────────────────────
# `npm run set-password` generates this for you if it's empty
AUTH_SECRET=
# localhost for dev; on Vercel set to https://your-project.vercel.app
AUTH_URL=http://localhost:3000

# ── neon postgres ────────────────────────────────────────────
# use the POOLED connection string on Vercel (toggle in Neon dashboard)
# postgresql://user:pass@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# remove channel_binding=require if present — breaks the HTTP driver
DATABASE_URL=

# ── cloudflare r2 ────────────────────────────────────────────
# https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── the three counter dates (YYYY-MM-DD) ─────────────────────
COUNTER_MET=
COUNTER_FRIENDS=
COUNTER_TOGETHER=

# ── web push (optional — daily 9pm reminder via Vercel cron) ─
# generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# random string — Vercel cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
