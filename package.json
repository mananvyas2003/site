{
  "name": "manno-weds-momo",
  "version": "1.0.0",
  "private": true,
  "description": "a private, two-person memory archive",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "db:generate": "node ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs src/db/seed.ts",
    "check": "node ./node_modules/tsx/dist/cli.mjs scripts/check-unlock.ts && node ./node_modules/tsx/dist/cli.mjs scripts/check-dates.ts && node ./node_modules/tsx/dist/cli.mjs scripts/check-auth.ts && node ./node_modules/typescript/bin/tsc --noEmit",
    "set-password": "node ./node_modules/tsx/dist/cli.mjs scripts/set-password.ts",
    "check-conn": "node ./node_modules/tsx/dist/cli.mjs scripts/check-conn.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@neondatabase/serverless": "^0.10.4",
    "blurhash": "^2.0.5",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "^0.38.3",
    "exifr": "^7.1.3",
    "lenis": "^1.1.18",
    "motion": "^11.15.0",
    "next": "15.1.3",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
